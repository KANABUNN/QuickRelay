# Install to /etc/quick-relay/quick-relay.env (root:quick-relay, 0640).
# install.sh generates PAIRING_SECRET without printing it. Begin offline.
RELAY_MODE=offline
LISTEN_ADDR=127.0.0.1:8080
DATABASE_PATH=/var/lib/quick-relay/quickrelay.db
PAIRING_SECRET=REPLACE_WITH_RANDOM_64_HEX_CHARACTERS

DMDATA_AUTH_MODE=api_key
DMDATA_API_KEY=
# Subscribe only to contracted classifications. Unsupported names fail closed.
# Only VXSE45, VXSE43, VXSE51, VXSE52 and VXSE53 are supported.
DMDATA_CLASSIFICATIONS=eew.forecast,eew.warning,telegram.earthquake
# Legacy DMDATA_TOKEN is supported. For oauth, leave API_KEY empty and use TOKEN.
DMDATA_TOKEN=

APNS_TEAM_ID=
APNS_BUNDLE_ID=jp.kb-dev.quickrelay
# sandbox (= development), production, or explicitly both.
# A scoped common key is used only for the environment selected here.
APNS_ENVIRONMENT=sandbox
APNS_KEY_ID=
APNS_KEY_PATH=/etc/quick-relay/keys/AuthKey.p8
# Legacy APNS_KEY_FILE is supported when APNS_KEY_PATH is empty.
# Set both ID+PATH to override the common key for an environment.
# Use APNS_ENVIRONMENT=both to serve Debug and TestFlight with different keys.
APNS_SANDBOX_KEY_ID=
APNS_SANDBOX_KEY_PATH=
APNS_PRODUCTION_KEY_ID=
APNS_PRODUCTION_KEY_PATH=

# Optional apns-send CLI input; prefer -installation-id after pairing.
APNS_DEVICE_TOKEN=
