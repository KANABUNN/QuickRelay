    "/api/v1/reports/{id}/source": {
      "get": {
        "summary": "Download one original non-EEW document or BUFR fragment",
        "description": "Requires device authentication. EEW source documents are deliberately unavailable. Binary fragments are not implicitly assembled.",
        "security": [
          {
            "deviceBearer": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,128}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Original decoded bytes, with attachment filename and no-store",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required"
          },
          "404": {
            "description": "Source document unavailable"
          }
        }
      }
    },
    "/api/v1/devices/me/notification-tests": {
      "post": {
        "summary": "Send a labelled diagnostic to the requesting installation only",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "request_id",
                  "style"
                ],
                "properties": {
                  "request_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]{1,128}$"
                  },
                  "style": {
                    "enum": [
                      "normal",
                      "warning"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "ok",
                    "test",
                    "cooldown_seconds"
                  ],
                  "properties": {
                    "ok": {
                      "const": true
                    },
                    "test": {
                      "$ref": "#/components/schemas/NotificationTest"
                    },
                    "cooldown_seconds": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Installation authentication required"
          },
          "409": {
            "description": "Notifications or installation disabled"
          },
          "429": {
            "description": "One new request per 60 seconds"
          },
          "503": {
            "description": "APNs unavailable"
          }
        }
      }
    },
    "/api/v1/devices/me/notification-tests/{test}": {
      "get": {
        "summary": "Read this installation's diagnostic",
        "parameters": [
          {
            "name": "test",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,128}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "ok",
                    "test",
                    "cooldown_seconds"
                  ],
                  "properties": {
                    "ok": {
                      "const": true
                    },
                    "test": {
                      "$ref": "#/components/schemas/NotificationTest"
                    },
                    "cooldown_seconds": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Authentication required"
          },
          "404": {
            "description": "Unknown or not owned"
          }
        }
      }
    },
    "/api/v1/devices/me/live-activity/start-token": {
      "put": {
        "summary": "Register or rotate an ActivityKit push-to-start token",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "push_token"
                ],
                "properties": {
                  "push_token": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 512,
                    "pattern": "^[A-Fa-f0-9]+$"
                  }
                }
              }
            }
