# EEW bridge settings (/etc/quick-relay-bridge/bridge.env). No secret values:
# device tokens are stored only as SHA-256 digests in the bridge database.
EEW_BRIDGE_DATABASE=/var/lib/quick-relay-bridge/bridge.db
# Loopback only; Caddy terminates TLS and forwards /v1/eew here.
EEW_BRIDGE_LISTEN=127.0.0.1:9082
# Must equal EEW_HANDOFF_SOCKET in /etc/quick-relay/quick-relay.env.
EEW_HANDOFF_SOCKET=/run/quick-relay-handoff/handoff.sock
