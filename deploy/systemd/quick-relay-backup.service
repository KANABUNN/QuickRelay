[Unit]
Description=Encrypted Quick Relay daily backup
After=quick-relay.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/quick-relay/operations.py backup
UMask=0077
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=30min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/quick-relay /var/lib/quick-relay-ops
# SQLite may need to create/update its WAL shared-memory sidecar while reading.
ReadWritePaths=/var/lib/quick-relay
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
